@echo off
rem Claude Desktop, default profile (%APPDATA%\Claude). Keeps the window title set to "Profile1".
powershell -NoProfile -WindowStyle Hidden -Command "$p=Get-AppxPackage -Name Claude | Select-Object -First 1; Start-Process (Join-Path $p.InstallLocation 'app\claude.exe'); Add-Type -TypeDefinition 'using System;using System.Runtime.InteropServices;public class W{[DllImport(\"user32.dll\",CharSet=CharSet.Unicode)]public static extern bool SetWindowTextW(IntPtr h,string s);}'; for($i=0;$i -lt 36000;$i++){ $m=@(Get-CimInstance Win32_Process | Where-Object {$_.Name -eq 'claude.exe' -and $_.CommandLine -notlike '*--user-data-dir*' -and $_.CommandLine -notlike '*--type=*'}); foreach($x in $m){ $h=(Get-Process -Id $x.ProcessId -ErrorAction SilentlyContinue).MainWindowHandle; if($h -and $h -ne 0){[void][W]::SetWindowTextW($h,'Profile1')} }; if($m.Count -eq 0 -and $i -gt 30){break}; Start-Sleep 1 }"
